{% capture footer_contents %}
  <div>&copy; Copyright {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}. {{ site.footer_text }}</div>
  {% if site.impressum_path %}
    <div>
      <a href="{{ site.impressum_path | relative_url }}">Impressum</a> &middot;
      <a href="{{ '/privacy/' | relative_url }}">Privacy</a>
    </div>
  {% endif %}
  {% if site.last_updated %}
    <div>Last updated: {{ 'now' | date: '%B %d, %Y' }}.</div>
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
