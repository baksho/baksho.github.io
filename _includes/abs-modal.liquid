<!-- Abstract pop-up (opened by the Abstract buttons on publications; see assets/js/sb-ui.js) -->
<div class="sb-modal" id="sbAbsModal" role="dialog" aria-modal="true" aria-labelledby="sbAbsTitle" hidden>
  <div class="sb-modal-card">
    <button class="sb-modal-close" type="button" aria-label="Close abstract">&times;</button>
    <p class="sb-modal-kicker">Abstract</p>
    <h2 class="sb-modal-title" id="sbAbsTitle"></h2>
    <p class="sb-modal-text" id="sbAbsText"></p>
  </div>
</div>
