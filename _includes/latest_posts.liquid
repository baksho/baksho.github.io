<div class="sb-post-rows">
  {% if page.latest_posts != blank %}
    {% assign latest_posts_limit = page.latest_posts.limit | default: site.posts.size %}
    {% for item in site.posts limit: latest_posts_limit %}
      {% if item.redirect == blank %}
        {% assign item_href = item.url | relative_url %}
        {% assign item_ext = false %}
      {% elsif item.redirect contains '://' %}
        {% assign item_href = item.redirect %}
        {% assign item_ext = true %}
      {% else %}
        {% assign item_href = item.redirect | relative_url %}
        {% assign item_ext = false %}
      {% endif %}
      <article class="sb-post-row">
        <a
          class="sb-post-thumb"
          href="{{ item_href }}"
          {% if item_ext %}
            target="_blank" rel="noopener noreferrer"
          {% endif %}
          tabindex="-1"
          aria-hidden="true"
        >
          {% if item.thumbnail %}<img src="{{ item.thumbnail | relative_url }}" alt="" loading="lazy">{% endif %}
        </a>
        <div class="sb-post-info">
          <h3 class="sb-post-title">
            <a
              href="{{ item_href }}"
              {% if item_ext %}
                target="_blank" rel="noopener noreferrer"
              {% endif %}
            >
              {{- item.title -}}
            </a>
          </h3>
          {% if item.description != blank %}
            <p class="sb-post-desc">{{ item.description }}</p>
          {% endif %}
          <p class="sb-post-meta">
            {% unless item.hide_date -%}
              {{- item.date | date: '%B %Y' -}}
              {%- if item.external_source %} &nbsp;·&nbsp; {% endif -%}
            {%- endunless -%}
            {%- if item.external_source %}{{ item.external_source }}{% endif %}
            {% if item_ext -%}
              &nbsp;·&nbsp;
              <a href="{{ item_href }}" target="_blank" rel="noopener noreferrer"
                >read on {{ item.external_source | default: 'the web' }}
                <i class="fa-solid fa-arrow-up-right-from-square fa-xs"></i
              ></a>
            {%- endif %}
          </p>
        </div>
      </article>
    {% endfor %}
  {% else %}
    <p>No posts so far...</p>
  {% endif %}
</div>
