<!-- Particle-ring landing page (shown once per browser session; see assets/js/stage.js) -->
<div class="sb-landing-ui" id="sbLanding">
  <div class="sb-tag">
    <span class="cyc">~/</span><span class="name">Suvinava</span> <span class="cyc">$</span> <span class="typed" id="sbTyped"></span
    ><span class="cyc cursor">_</span><span class="msg" id="sbMsg">command not found</span>
  </div>
  <button class="sb-enter" id="sbEnterBtn" type="button">[ enter → ]</button>
  <div class="sb-hint">
    click to pulse · hold to enter · type <span class="chip">cd suvinava</span> and press enter · tweak the look with the side icons
  </div>
  <button class="sb-theme" id="sbThemeBtn" type="button" data-pref="system" aria-label="Theme: system">
    <!-- light: full sun -->
    <svg class="i-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="5" fill="currentColor" stroke="none"/>
      <path d="M12 1.5v2.2M12 20.3v2.2M3.6 3.6l1.6 1.6M18.8 18.8l1.6 1.6M1.5 12h2.2M20.3 12h2.2M3.6 20.4l1.6-1.6M18.8 5.2l1.6-1.6"/>
    </svg>
    <!-- system: left half moon, right half sun -->
    <svg class="i-system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M12 6.8A5.2 5.2 0 0 0 12 17.2A2.6 5.2 0 0 1 12 6.8Z" fill="currentColor" stroke="none"/>
      <path d="M12 6.8A5.2 5.2 0 0 1 12 17.2Z" fill="currentColor" stroke="none"/>
      <path d="M12 2.6v1.8M12 19.6v1.8M17.4 6.6l1.3-1.3M17.4 17.4l1.3 1.3M18.6 12h2.4"/>
    </svg>
    <!-- dark: crescent moon -->
    <svg class="i-dark" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
    </svg>
  </button>
  <!-- left dock: light (glow + brightness) -->
  <div class="sb-dock left" id="sbDockL">
    <button class="sb-dockBtn" type="button" aria-label="Light settings: glow and brightness" title="Light: glow &amp; brightness">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M11 2.5C11.6 7.6 14.4 10.4 19.5 11C14.4 11.6 11.6 14.4 11 19.5C10.4 14.4 7.6 11.6 2.5 11C7.6 10.4 10.4 7.6 11 2.5Z"/>
        <path d="M18.5 15C18.7 17 19.5 17.8 21.5 18C19.5 18.2 18.7 19 18.5 21C18.3 19 17.5 18.2 15.5 18C17.5 17.8 18.3 17 18.5 15Z"/>
      </svg>
    </button>
    <div class="sb-panel">
      <div class="sb-box">
        <div class="sb-row">
          <div class="sb-ctl">
            <span class="sb-val" data-v="glow">75</span>
            <div class="sb-vs"><input type="range" min="0" max="100" step="1" value="75" data-k="glow" aria-label="Glow"></div>
            <span class="sb-lab">glow</span>
          </div>
          <div class="sb-ctl">
            <span class="sb-val" data-v="brightness">95</span>
            <div class="sb-vs"><input type="range" min="0" max="100" step="1" value="95" data-k="brightness" aria-label="Brightness"></div>
            <span class="sb-lab">brightness</span>
          </div>
        </div>
        <button class="sb-reset" type="button">reset</button>
      </div>
    </div>
  </div>
  <!-- right dock: particles (density + detail) -->
  <div class="sb-dock right" id="sbDockR">
    <button class="sb-dockBtn" type="button" aria-label="Particle settings: density and detail" title="Particles: density &amp; detail">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <circle cx="5" cy="5" r="1.8"/><circle cx="12" cy="5" r="1.8"/><circle cx="19" cy="5" r="1.8"/>
        <circle cx="5" cy="12" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="19" cy="12" r="1.8" opacity=".55"/>
        <circle cx="5" cy="19" r="1.8"/><circle cx="12" cy="19" r="1.8" opacity=".55"/><circle cx="19" cy="19" r="1.8" opacity=".3"/>
      </svg>
    </button>
    <div class="sb-panel">
      <div class="sb-box">
        <div class="sb-row">
          <div class="sb-ctl">
            <span class="sb-val" data-v="density">70</span>
            <div class="sb-vs"><input type="range" min="0" max="100" step="1" value="70" data-k="density" aria-label="Density"></div>
            <span class="sb-lab">density</span>
          </div>
          <div class="sb-ctl">
            <span class="sb-val" data-v="detail">85</span>
            <div class="sb-vs"><input type="range" min="0" max="100" step="1" value="85" data-k="detail" aria-label="Detail"></div>
            <span class="sb-lab">detail</span>
          </div>
        </div>
        <button class="sb-reset" type="button">reset</button>
      </div>
    </div>
  </div>
</div>
