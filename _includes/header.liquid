<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-lg {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container-fluid sb-nav-inner">
      <!-- SB logo + name: always links back to the About page -->
      <a class="navbar-brand sb-brand" href="{{ '/' | relative_url }}" aria-label="{{ site.first_name }} {{ site.last_name }}, home">
        <svg class="sb-logo" viewBox="0 0 40 40" width="34" height="34" aria-hidden="true" focusable="false">
          <defs>
            <linearGradient id="sbRing" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" style="stop-color: var(--sb-c1, #5af0b8)"></stop>
              <stop offset="1" style="stop-color: var(--sb-c2, #8a6cff)"></stop>
            </linearGradient>
          </defs>
          <circle cx="20" cy="20" r="18" fill="none" stroke="url(#sbRing)" stroke-width="2.2"></circle>
          <text x="20" y="25.4" text-anchor="middle" class="sb-logo-text">SB</text>
        </svg>
        <span class="sb-name">{{ site.first_name }} {{ site.last_name }}</span>
      </a>
      <!-- Search + theme (always visible, also on phones) -->
      <div class="sb-tools">
        {% if site.search_enabled %}
          <button id="search-toggle" title="Search (ctrl k)" aria-label="Search" onclick="openSearchModal()">
            <span class="nav-link"><i class="fa-solid fa-magnifying-glass"></i></span>
          </button>
        {% endif %}
        {% if site.enable_darkmode %}
          <!-- Theme: system (half sun / half moon) -> light (sun) -> dark (crescent) -->
          <button id="light-toggle" title="Change theme" aria-label="Change theme">
            <svg id="light-toggle-system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M12 6.8A5.2 5.2 0 0 0 12 17.2A2.6 5.2 0 0 1 12 6.8Z" fill="currentColor" stroke="none"/>
              <path d="M12 6.8A5.2 5.2 0 0 1 12 17.2Z" fill="currentColor" stroke="none"/>
              <path d="M12 2.6v1.8M12 19.6v1.8M17.4 6.6l1.3-1.3M17.4 17.4l1.3 1.3M18.6 12h2.4"/>
            </svg>
            <svg id="light-toggle-dark" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
            </svg>
            <svg id="light-toggle-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="5" fill="currentColor" stroke="none"/>
              <path d="M12 1.5v2.2M12 20.3v2.2M3.6 3.6l1.6 1.6M18.8 18.8l1.6 1.6M1.5 12h2.2M20.3 12h2.2M3.6 20.4l1.6-1.6M18.8 5.2l1.6-1.6"/>
            </svg>
          </button>
        {% endif %}
      </div>
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse sb-collapse" id="navbarNav">
        <ul class="navbar-nav sb-tabs flex-nowrap">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              {{- about_title }}
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
